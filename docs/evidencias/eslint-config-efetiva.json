{
  "eslint": "8.57.1",
  "sonarjs": "0.21.0",
  "env": {
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "cognitiveComplexity": [
    "error",
    15
  ],
  "noIdenticalFunctions": [
    "error"
  ],
  "noUndef": [
    "error"
  ],
  "recommendedSonarRulesEnabled": 30,
  "disabledRecommendedSonarRules": []
}
